# 이 파일을 같은 폴더에 application-local.yml 로 복사해서 사용한다. (.gitignore 대상, 공유 금지)
spring:
  datasource:
    username: passpace
    password: 여기에_DB_비밀번호

passpace:
  collect:
    data-go-kr-key: 여기에_공공데이터포털_Decoding_인증키
  claude:
    api-key: 여기에_Claude_API_키      # https://platform.claude.com 에서 발급 (sk-ant-...). 환경변수 ANTHROPIC_API_KEY 로 줘도 된다
