# 이 파일을 같은 폴더에 application-local.yml 로 복사해서 사용한다. (.gitignore 대상, 공유 금지)
spring:
  datasource:
    username: passpace
    password: 여기에_DB_비밀번호

passpace:
  admin:
    password: 여기에_관리자_비밀번호     # /admin/collect 들어갈 때 입력
  collect:
    data-go-kr-key: 여기에_공공데이터포털_Decoding_인증키
  ollama:
    model: qwen3.5:4b
