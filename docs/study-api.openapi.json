          "durationMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440
          },
          "taskId": {
            "type": "integer",
            "minimum": 1,
            "nullable": true,
            "format": "int64"
          },
          "planId": {
            "type": "integer",
